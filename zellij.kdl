// opendox dev workspace. Launch with: `zj opendox`.
// `bash -ic` wrappers so panes pick up PATH from ~/.bashrc (mise, claude, ~/bin).
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="shell" focus=true
    tab name="claude" {
        pane {
            command "bash"
            args "-ic" "claude"
        }
    }
}
